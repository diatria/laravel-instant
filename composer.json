{
  "name": "diatria/laravel-instant",
  "type": "library",
  "description": "Library to speed up application creation",
  "keywords": [
    "php",
    "laravel",
    "instant"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Dimas Adi Satria"
    }
  ],
  "require": {
    "php": ">=7.4",
    "illuminate/console": "^6.0|^7.0|^8.0",
    "illuminate/database": "^6.0|^7.0|^8.0",
    "illuminate/http": "^6.0|^7.0|^8.0",
    "illuminate/pagination": "^6.0|^7.0|^8.0",
    "illuminate/routing": "^6.0|^7.0|^8.0",
    "illuminate/support": "^6.0|^7.0|^8.0",
    "firebase/php-jwt": "^5.5|^6.10",
    "nesbot/carbon": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Diatria\\LaravelInstant\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests"
    }
  },
  "require-dev": {
    "orchestra/testbench": "^4.0|^5.0|^6.0",
    "phpunit/phpunit": "^8.0|^9.0",
    "phpstan/phpstan": "^1.0"
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "@php -d memory_limit=512M vendor/bin/phpstan analyse src --level=5 --memory-limit=512M --no-progress"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Diatria\\LaravelInstant\\LaravelInstantServiceProvider"
      ]
    }
  }
}
